# Copy to .env; generate independent random secrets before running.
DATABASE_URL=postgresql+asyncpg://crm_runtime:replace-runtime-password@localhost:55432/crm
MIGRATION_DATABASE_URL=postgresql+asyncpg://crm_owner:replace-owner-password@localhost:55432/crm
JWT_SECRET=
CSRF_SECRET=
SMS_DIGEST_SECRET=
ENVIRONMENT=dev
APP_TIMEZONE=Asia/Tehran
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SMS_MODE=fixed
SMS_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT_SECONDS=5
SMS_CODE_TTL_SECONDS=300
SMS_MAX_ATTEMPTS=5
SMS_RESEND_COOLDOWN_SECONDS=60
# POS XLSX imports: private persistent directory, not served as static files.
IMPORT_STORAGE_DIR=var/imports
IMPORT_MAX_MB=10
IMPORT_MAX_ROWS=5000
# Compose initialization only; match the URLs above.
POSTGRES_DB=crm
POSTGRES_USER=crm_owner
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
# Private Docker network; nginx alone is trusted for forwarded headers.
CRM_SUBNET=172.25.0.0/16
NGINX_IP=172.25.0.10
